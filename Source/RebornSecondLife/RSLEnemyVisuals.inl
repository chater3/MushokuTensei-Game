const FRSLEnemyVisual* ARSLEnemyCharacter::FindVisual(const FString& Id)
{
	for (const FRSLEnemyVisual& Vis : GEnemyVisuals)
	{
		if (Id.Equals(Vis.Id, ESearchCase::IgnoreCase))
		{
			return &Vis;
		}
	}
	return nullptr;
}